{
	"name": "be-map-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "dist/BeMapApp.umd.js",
	"module": "dist/BeMapApp.es.js",
	"types": "dist/lib/BeMapApp.ts",
	"exports": {
		".": {
			"import": "./dist/BeMapApp.es.js",
			"require": "./dist/BeMapApp.umd.js",
			"types": "./dist/lib/BeMapApp.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --port 5176",
		"build": "tsc --p ./tsconfig.build.json && vite build",
		"build-dev": "vite -c vite-build-dev.config.js build",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@adobe/lit-mobx": "^2.2.2",
		"@types/lodash-es": "^4.17.12",
		"chart.js": "^4.4.2",
		"highlightable-map": "github:graphographer/highlightable-map",
		"leaflet": "^1.9.4",
		"lit": "^3.1.2",
		"lodash-es": "^4.17.21",
		"mobx": "^6.12.0"
	},
	"devDependencies": {
		"@rollup/plugin-dsv": "^3.0.4",
		"@types/leaflet": "^1.9.8",
		"postcss": "^8.4.35",
		"rollup-plugin-minify-html-literals": "^1.2.6",
		"sass": "^1.71.1",
		"typescript": "^5.2.2",
		"vite": "^5.1.4",
		"vite-bundle-visualizer": "^1.1.0",
		"vite-plugin-dts": "^4.3.0"
	}
}
